# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Set to true once the Google provider is enabled in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server only (never NEXT_PUBLIC_). Supabase → Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=sb_secret_xxx
# AI: Gemini first, Groq as fallback. At least one key is needed for AI features.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: comma-separated model ids to try in order.
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
# Any long random string. Vercel's daily cron uses it to call /api/cron/cleanup-proofs.
CRON_SECRET=
# Web push (step 10). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
